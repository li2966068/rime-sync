{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rime-sync",
  "version": "0.6.3",
  "identifier": "com.rimesync.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rime 同步",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/li2966068/rime-sync/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQUY0NDg1NzBFODVBMUYKUldRZld1aHdoVVN2TWx6VE90cTF3dmJLdU9iZ2NwKzZlUWhLbXlVMDdrQUR5VUFTaCtQdVBMVFgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Rime 词库与配置的 WebDAV 双向同步",
    "longDescription": "把 Rime 的用户词库快照、custom.yaml 与词典源通过用户自有的 WebDAV 在 Windows 与 Linux 之间双向同步；支持只搬运不打断输入，以及手动合并生效。",
    "resources": {
      "../packaging/windows/vendor/GPL-3.0.txt": "resources/GPL-3.0.txt",
      "../packaging/windows/vendor/WEASEL-NOTICE.txt": "resources/WEASEL-NOTICE.txt",
      "../packaging/windows/vendor/README.md": "resources/README.md",
      "../packaging/rime/default.custom.yaml": "resources/default.custom.yaml",
      "../packaging/rime/weasel.custom.yaml": "resources/weasel.custom.yaml"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": [],
        "recommends": [
          "fcitx5",
          "fcitx5-rime",
          "librime-data"
        ],
        "files": {
          "/usr/share/rime-sync/defaults/default.custom.yaml": "../packaging/rime/default.custom.yaml",
          "/usr/share/doc/rime-sync/README.Debian": "../packaging/linux/README.Debian",
          "/usr/share/applications/rime-sync-setup.desktop": "../packaging/linux/rime-sync-setup.desktop",
          "/usr/lib/rime-sync/install-vendor-deps.sh": "../packaging/linux/install-vendor-deps.sh",
          "/usr/lib/rime-sync/uninstall.sh": "../packaging/linux/uninstall.sh",
          "/usr/share/applications/rime-sync-uninstall.desktop": "../packaging/linux/rime-sync-uninstall.desktop",
          "/usr/bin/rime-sync-status": "../packaging/linux/rime-sync-status",
          "/usr/bin/rime-sync-cli": "../packaging/linux/rime-sync-cli"
        },
        "postInstallScript": "../packaging/linux/postinst",
        "preRemoveScript": "../packaging/linux/prerm",
        "postRemoveScript": "../packaging/linux/postrm"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Rime 同步",
        "installerHooks": "../packaging/nsis-hooks.nsh"
      }
    }
  }
}
