# 前端
node_modules/
dist/
pnpm-debug.log*
*.local

# Python（scripts/ime 的生成器会 import rime_common）
__pycache__/
*.pyc

# Rust / Tauri
target/
src-tauri/target/
src-tauri/gen/

# 打包产物（CI 上传，不入库）
packaging/out/
*.deb
*.AppImage
*.msi

# IME 从源码构建的 staging/产物（scripts/ime/**）
build/

# Rime / 同步数据（红线：LevelDB 目录与词库快照都不入库）
*.userdb/
*.userdb
*.userdb.txt

# 本地配置与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 更新签名私钥（SPEC-4 §B1：只存本地与 GitHub Secrets，绝不入库）
.secrets/

# 系统噪音
*.log
.DS_Store
Thumbs.db
packaging/linux/rime-sync-cli

# 跑 rimesync-extra 冒烟测试时 librime 会把 user.yaml 写在当前工作目录
