#!/bin/bash
# rime-sync postinst
# 原则：安装失败都不许让 postinst 自己中断安装；不在 root 下弹窗；不碰用户数据目录。
#
# 为什么依赖安装是"后台排队"而不是同步执行：
#   dpkg 在运行 postinst 期间持有 /var/lib/dpkg/lock-frontend 与数据库锁，
#   postinst 里直接调 dpkg -i / apt-get install 会被锁拒掉
#   （实测：dpkg: error: dpkg frontend lock was locked by another process）。
#   所以这里只做检测 + 起一个脱离的后台 worker，由它等锁释放后再装。
#
# 失败可见（docs/FALLBACK-POLICY.md）：
#   worker 的失败以前只有 /var/log/rime-sync/vendor-install.log 里的一行字，用户看不到。
#   现在由 /var/lib/rime-sync/install-vendor-deps-wrapper.sh 在失败时写
#     ~/.config/com.rimesync.app/install-warning.json
#   （含时间、包名、日志路径），应用诊断页据此显示红条并提供「查看日志 / 重试」；
#   成功则删掉该文件。重试 = pkexec bash /var/lib/rime-sync/install-vendor-deps-wrapper.sh
set -u

WORKER=/usr/lib/rime-sync/install-vendor-deps.sh
WRAPPER=/var/lib/rime-sync/install-vendor-deps-wrapper.sh
LOGDIR=/var/log/rime-sync

# 桌面入口用 pkexec 直接执行卸载脚本；dpkg-deb 打包自定义文件时不一定保留执行位
# （tauri 的 deb.files 由打包器复制），这里补一次 0755。
UNINSTALLER=/usr/lib/rime-sync/uninstall.sh
[ -f "$UNINSTALLER" ] && chmod 0755 "$UNINSTALLER" 2>/dev/null
# fcitx5-rime 配置页的「查看同步状态」按钮调用它，同样需要执行位。
STATUS_HELPER=/usr/bin/rime-sync-status
[ -f "$STATUS_HELPER" ] && chmod 0755 "$STATUS_HELPER" 2>/dev/null
# fcitx5 配置页的「立即同步」按钮调用它（CLI 由 release.yml 在打包前编译）。
CLI_HELPER=/usr/bin/rime-sync-cli
[ -f "$CLI_HELPER" ] && chmod 0755 "$CLI_HELPER" 2>/dev/null
LOG=$LOGDIR/vendor-install.log

say() { printf '[rime-sync] %s\n' "$*"; }

rime_im_installed() {
    # The offline bundle ships our own rime-inputmethod (Provides: fcitx5-rime),
    # and dpkg-query does not resolve virtual packages by name, so check the
    # concrete package first. Without this the postinst would queue a worker
    # that tries to apt-install the distribution fcitx5-rime, which conflicts
    # with rime-inputmethod and could remove it right after installation.
    [ "$(dpkg-query -W -f='${Status}' rime-inputmethod 2>/dev/null || true)" = "install ok installed" ] ||
        [ "$(dpkg-query -W -f='${Status}' fcitx5-rime 2>/dev/null || true)" = "install ok installed" ]
}

# ---------------------------------------------------------------- 目标用户
# postinst 以 root 运行，但 install-warning.json 必须落到"用桌面的那个人"的
# ~/.config/com.rimesync.app/ 下，否则应用永远读不到。
pick_target_user() {
    local user="${RIMESYNC_TARGET_USER:-}"
    if [ -n "$user" ]; then printf '%s' "$user"; return; fi
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then printf '%s' "$SUDO_USER"; return; fi
    if [ -n "${PKEXEC_UID:-}" ]; then
        user=$(id -nu "$PKEXEC_UID" 2>/dev/null || true)
        if [ -n "$user" ] && [ "$user" != root ]; then printf '%s' "$user"; return; fi
    fi
    user=$(logname 2>/dev/null || true)
    if [ -n "$user" ] && [ "$user" != root ]; then printf '%s' "$user"; return; fi
    # 只有一个普通用户时兜底（离线安装器 / 首次配置最常见的场景）
    local cand
    for cand in /home/*; do
        [ -d "$cand" ] || continue
        user=$(basename "$cand")
        if id -u "$user" >/dev/null 2>&1; then printf '%s' "$user"; return; fi
    done
    printf ''
}

target_home() {
    local user=$1 home=""
    if [ -n "${RIMESYNC_TARGET_HOME:-}" ] && [ -d "${RIMESYNC_TARGET_HOME}" ]; then
        printf '%s' "$RIMESYNC_TARGET_HOME"
        return
    fi
    if [ -n "$user" ]; then
        home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6)
    fi
    if [ -n "$home" ] && [ -d "$home" ]; then printf '%s' "$home"; return; fi
    printf ''
}

# ---------------------------------------------------------------- 配置根目录（XDG）
# 三个脚本（postinst / uninstall.sh / install-extra-ime.sh）取「配置目录」的地方
# 统一走这里，规则与 Rust 侧 crates/core/src/rime_dir.rs 的 config_home() 一致：
# 「XDG_CONFIG_HOME 优先，缺省 ~/.config」。
#
# 为什么不能直接写 ${XDG_CONFIG_HOME:-$HOME/.config}：这三个脚本都以 root 跑
# （dpkg 调 postinst / pkexec 调卸载器），进程里的 XDG_CONFIG_HOME 是 **root 的**，
# 而我们要找的是**桌面用户**的（~/.config/fcitx5/conf/rime.conf 在谁 home 下）。
# 所以按下面的优先级解析（**三个脚本必须逐条一致**，改一处要同步另两处）：
#   1. RIMESYNC_TARGET_CONFIG_HOME：显式指定（安装器 / 测试注入）。
#   2. 目标用户环境文件里导出的 XDG_CONFIG_HOME：~/.pam_environment、
#      ~/.config/environment（systemd 用户级）、~/.profile、~/.bashrc
#      （只认行首的 `XDG_CONFIG_HOME=` 或 `export XDG_CONFIG_HOME=`）。
#   3. 当前进程环境里的 XDG_CONFIG_HOME —— 只在 home 就是当前 $HOME 时才认
#      （脚本以该用户身份直接跑的情形）。
#   4. $home/.config（XDG 缺省值）。
# 与 Rust 侧的唯一差别：Rust 读的是**自己进程**的环境变量（应用跑在用户会话里，
# 本来就是对的），shell 需要替目标用户去找。
resolve_config_home() { # $1=目标用户 HOME
    local home=$1 value="" file=""
    [ -n "$home" ] || { printf ''; return 0; }
    if [ -n "${RIMESYNC_TARGET_CONFIG_HOME:-}" ]; then
        printf '%s' "$RIMESYNC_TARGET_CONFIG_HOME"
        return 0
    fi
    for file in "$home/.pam_environment" "$home/.config/environment" \
        "$home/.profile" "$home/.bashrc"; do
        [ -r "$file" ] || continue
        value=$(grep -m1 -E '^[[:space:]]*(export[[:space:]]+)?XDG_CONFIG_HOME=' \
            "$file" 2>/dev/null || true)
        [ -n "$value" ] || continue
        value=${value#*=}
        value=$(printf '%s' "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        value=${value#\"}
        value=${value%\"}
        value=${value#\'}
        value=${value%\'}
        # $HOME / ~ 展开成目标用户的 home（用字符串切片，不用 glob）。
        if [ "${value:0:6}" = '$HOME/' ]; then
            value=$home/${value:6}
        elif [ "${value:0:2}" = '~/' ]; then
            value=$home/${value:2}
        fi
        # 只认绝对路径（相对路径按未设置处理）。
        case "$value" in
            /*) printf '%s' "$value"; return 0 ;;
        esac
    done
    if [ "$home" = "${HOME:-}" ] && [ -n "${XDG_CONFIG_HOME:-}" ]; then
        printf '%s' "$XDG_CONFIG_HOME"
        return 0
    fi
    printf '%s' "$home/.config"
}

# ---------------------------------------------------------------- Rime 用户目录
# fcitx5-rime 可以在 ~/.config/fcitx5/conf/rime.conf 里用 UserDataDirPath 指定
# 用户数据目录（自建 fcitx5-rime 新增的选项）。fcitx5 真正读写的正是那个目录，
# 不是默认的 ~/.local/share/fcitx5/rime。
# 以前这里硬编码默认目录，于是受管 custom.yaml 与预编译产物都 seed 到了没人读的
# 目录，用户真正在用的目录反而缺文件（表现为「切不到五笔 / check-ime 恒 failed」）。
#
# 权威实现在 crates/core/src/rime_dir.rs（parse_fcitx5_user_data_dir + detect）。
# 这里优先调用 rime-sync-cli detect --json 取同一个答案，免得 shell 与 Rust 各写
# 一套规则而算到不同目录（安装器算一套、卸载器算另一套 ⇒ 卸载删错目录）。
# CLI 还没装好时（dpkg 维护脚本运行时二进制可能缺席）退回本地解析，
# 且本地解析的规则与 Rust 侧**逐条相同**。
#
# 本地解析规则（= crates/core/src/rime_dir.rs 的 parse_fcitx5_user_data_dir）：
#   1. 分隔符 = 与 : 都支持；值是分隔符之后的全部内容（允许含 =）；
#   2. 键名（去空白后）必须正好是 UserDataDirPath，否则跳过该行；
#   3. 值先去掉两端空白，再剥掉**成对**的双引号或单引号；
#   4. 空值视为未设置；
#   5. ~ 展开为 HOME，~/xxx 展开为 $HOME/xxx；
#   6. **必须是绝对路径**：相对路径按未设置处理（fcitx5 引擎自己也拒绝相对路径，
#      见 third_party/fcitx5-rime/src/rimeengine.cpp 的 resolveRimeUserDir；
#      不统一的话 rime-sync 与引擎会各读各的目录）；
#   7. 去掉末尾斜杠（根目录除外）。
# 改规则时必须同步五处：crates/core/src/rime_dir.rs、packaging/linux/postinst、
# packaging/linux/uninstall.sh、packaging/linux/install-extra-ime.sh、
# packaging/linux/install.sh（.run 离线安装器）。
#
# 注意：bash 的 case pattern 与 ${var#pattern} 都会先做 tilde 展开，
# 连双引号包住的 ~ 也也不例外（pattern 里的 ~ 会被换成 HOME），所以
# 这里一律不用 glob，改用字符串切片判断前缀。

# 纯本地解析：读 <配置根>/fcitx5/conf/rime.conf 里的 UserDataDirPath。
# 配置根由 resolve_config_home 决定（XDG_CONFIG_HOME 优先，缺省 ~/.config）。
# 输出规范化后的绝对路径；未设置（没有该键 / 值为空 / 相对路径）时输出空串。
parse_rime_user_data_dir() { # $1=目标用户的 HOME
    local home=$1 conf="" line="" key="" value=""
    [ -n "$home" ] || { printf ''; return 0; }
    conf=$(resolve_config_home "$home")/fcitx5/conf/rime.conf
    if [ -r "$conf" ]; then
        # 逐行找**第一处**匹配 UserDataDirPath 的行（后面的同名键不覆盖）。
        # 切分规则与 Rust 的 split_conf_entry 一致：先按 = 切（这样 Windows 盘符
        # C:\foo 不会被冒号切坏），键名对不上再按第一个 : 切。
        while IFS= read -r line || [ -n "$line" ]; do
            line=$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            case "$line" in
                ""|\#*|\[* ) continue ;;
            esac
            key=""
            value=""
            case "$line" in
                *=*) key=${line%%=*}; value=${line#*=} ;;
            esac
            key=$(printf '%s' "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ "$key" != "UserDataDirPath" ]; then
                key=""
                value=""
                case "$line" in
                    *:*) key=${line%%:*}; value=${line#*:} ;;
                esac
                key=$(printf '%s' "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                [ "$key" = "UserDataDirPath" ] || continue
            fi
            break
        done <"$conf"
    fi
    # 值规范化：去空白 → 剥成对引号 → 剥完再去一次空白。
    value=$(printf '%s' "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    case "$value" in
        \"*\") value=${value#\"}; value=${value%\"} ;;
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    value=$(printf '%s' "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$value" ] || { printf ''; return 0; }
    if [ "$value" = "~" ]; then
        value=$home
    elif [ "${value:0:2}" = "~/" ]; then
        value=$home/${value:2}
    fi
    # 必须是绝对路径：相对路径按未设置处理（与 fcitx5 引擎一致）。
    case "$value" in
        /*|[A-Za-z]:/*|[A-Za-z]:\\*) : ;;
        *) printf ''; return 0 ;;
    esac
    # 去掉末尾斜杠（根目录除外）。
    while [ "${value%/}" != "$value" ] && [ "$value" != "/" ]; do value=${value%/}; done
    # 盘符根 C:/ 去掉斜杠会变成 C:（语义变了），补回来。
    if [ ${#value} -eq 2 ] && [ "${value:1:1}" = ":" ]; then value="$value/"; fi
    printf '%s' "$value"
}

# 用 CLI 取权威值：rime-sync-cli detect --json 的 "path" 字段。
# 输出 "路径|来源"；CLI 不存在、执行失败或没给路径时输出空串。
rime_user_dir_from_cli() { # $1=目标用户的 HOME
    local home=$1 json="" path="" source=""
    [ -n "$home" ] || return 0
    command -v rime-sync-cli >/dev/null 2>&1 || return 0
    # HOME / XDG_CONFIG_HOME 指向目标用户（Rust 侧 config_home 优先用后者），
    # 并清掉 RIME_USER_DATA_DIR：那是 root 的环境，不是目标用户的。
    json=$(HOME="$home" XDG_CONFIG_HOME="$(resolve_config_home "$home")" RIME_USER_DATA_DIR= \
        rime-sync-cli detect --json 2>/dev/null || true)
    path=$(printf '%s' "$json" | sed -n 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
    source=$(printf '%s' "$json" | sed -n 's/.*"source"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
    [ -n "$path" ] || return 0
    printf '%s|%s' "$path" "$source"
}

# 最终目录：
#   * rime.conf 里显式配了 UserDataDirPath ⇒ 用它（那才是 fcitx5 引擎真正读写的
#     目录，即使它还不存在也不能换成别的目录）；
#   * 没配 ⇒ 用 CLI 的权威值（它还知道应用配置与历史候选目录）；
#   * CLI 也没装 ⇒ 用默认目录。
# 唯一的例外：CLI 的来源是 known:xxx（说明 CLI 因为配置目录当时不存在而回退到了
# 候选目录列表）。这时引擎用的仍是配置目录（引擎自己会把它创建出来），所以以
# 本地解析结果为准，否则受管 custom.yaml 会被 seed 到引擎根本不读的目录。
resolve_rime_user_dir() { # $1=目标用户的 HOME
    local home=$1 local_value="" cli_value="" cli_source=""
    [ -n "$home" ] || { printf ''; return 0; }
    local_value=$(parse_rime_user_data_dir "$home")
    cli_value=$(rime_user_dir_from_cli "$home")
    cli_source=${cli_value#*|}
    cli_value=${cli_value%%|*}
    # CLI 的来源决定优先级，与 Rust 的 detect 优先级一一对应：
    #   argument / env:... ⇒ 用户显式指定，权威值就是它；
    #   fcitx5-rime:... ⇒ 与本地解析结果相同（都用 rime.conf 的值）；
    #   known:...        ⇒ CLI 因为该目录当时不存在而回退到了候选目录列表。
    #     这种情况下 fcitx5 引擎用的仍是 rime.conf 里的目录（引擎自己会创建它），
    #     所以以本地解析结果为准，否则受管 custom.yaml 会被 seed 到没人读的目录。
    if [ -n "$cli_value" ] && [ "${cli_source#known:}" != "$cli_source" ]; then
        cli_value=""
    fi
    if [ -n "$cli_value" ]; then
        printf '%s' "$cli_value"
        return 0
    fi
    if [ -n "$local_value" ]; then
        printf '%s' "$local_value"
        return 0
    fi
    printf '%s' "$home/.local/share/fcitx5/rime"
}

TARGET_USER=$(pick_target_user)
TARGET_HOME=$(target_home "$TARGET_USER")
RIME_USER_DIR=$(resolve_rime_user_dir "$TARGET_HOME")
[ -n "$RIME_USER_DIR" ] || RIME_USER_DIR="~/.local/share/fcitx5/rime"
WARN_DIR=""
WARN_FILE=""
if [ -n "$TARGET_HOME" ]; then
    # 告警文件放在目标用户的**配置目录**下（Rust 侧按 XDG_CONFIG_HOME 找）：
    # 用户改过 XDG_CONFIG_HOME 时，应用的配置目录也跟着变，这里必须一致。
    WARN_DIR=$(resolve_config_home "$TARGET_HOME")/com.rimesync.app
    WARN_FILE=$WARN_DIR/install-warning.json
fi

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

write_install_warning() { # $1=package $2=reason
    local package=$1 reason=$2
    if [ -z "$WARN_FILE" ]; then
        say "找不到桌面用户的 HOME，无法写 install-warning.json；请转告用户：依赖安装未完成，日志 $LOG"
        return 0
    fi
    mkdir -p "$WARN_DIR" 2>/dev/null || {
        say "无法创建 $WARN_DIR，跳过 install-warning.json"
        return 0
    }
    cat >"$WARN_FILE" <<JSON
{
  "schema": 1,
  "written_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
  "package": "$(json_escape "$package")",
  "reason": "$(json_escape "$reason")",
  "log_path": "$(json_escape "$LOG")",
  "retry_command": "pkexec bash $WRAPPER $WARN_FILE"
}
JSON
    chmod 0644 "$WARN_FILE" 2>/dev/null || true
    if [ -n "$TARGET_USER" ]; then
        chown -R "$TARGET_USER":"$(id -gn "$TARGET_USER" 2>/dev/null || echo "$TARGET_USER")" \
            "$WARN_DIR" 2>/dev/null || true
    fi
    say "已写安装告警：$WARN_FILE（应用诊断页会显示红条）"
}

# ---------------------------------------------------------------- worker 包装
# worker 自己永远 exit 0（它把失败吞成一行日志），所以包装脚本按"目标包是否真的
# 装上"判定成败：失败写告警、成功清告警。retry 也复用它（幂等、可重复执行）。
install_worker_wrapper() {
    mkdir -p "$(dirname "$WRAPPER")" 2>/dev/null || return 1
    cat >"$WRAPPER" <<'WRAPPER_EOF'
#!/bin/bash
# 由 rime-sync 的 postinst 生成（每次安装/升级重写），不要手改。
# 用法：install-vendor-deps-wrapper.sh [install-warning.json 路径]
# 退出码：0 = 依赖已就绪（并清掉告警）；1 = 仍未就绪（已写告警）；2 = 缺 worker。
set -u
WORKER=/usr/lib/rime-sync/install-vendor-deps.sh
LOG=/var/log/rime-sync/vendor-install.log
WARN=${1:-}
STATUS_FMT='${Status}'

log() { printf '%s [rime-sync/wrapper] %s\n' "$(date '+%F %T')" "$*"; }

im_ready() {
    [ "$(dpkg-query -W -f="$STATUS_FMT" rime-inputmethod 2>/dev/null || true)" = "install ok installed" ] ||
        [ "$(dpkg-query -W -f="$STATUS_FMT" fcitx5-rime 2>/dev/null || true)" = "install ok installed" ]
}

write_warning() {
    [ -n "$WARN" ] || return 0
    mkdir -p "$(dirname "$WARN")" 2>/dev/null || return 0
    local reason
    reason=$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    cat >"$WARN" <<JSON
{
  "schema": 1,
  "written_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
  "package": "fcitx5-rime",
  "reason": "$reason",
  "log_path": "$LOG",
  "retry_command": "pkexec bash /var/lib/rime-sync/install-vendor-deps-wrapper.sh $WARN"
}
JSON
    chmod 0644 "$WARN" 2>/dev/null || true
}

mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

if [ ! -r "$WORKER" ]; then
    log "缺少 $WORKER，无法安装依赖"
    write_warning "缺少 /usr/lib/rime-sync/install-vendor-deps.sh，离线依赖没有开始安装"
    exit 2
fi

if im_ready; then
    log "依赖已就绪，跳过"
    [ -n "$WARN" ] && rm -f "$WARN" 2>/dev/null
    exit 0
fi

log "开始安装依赖（worker=$WORKER）"
bash "$WORKER" >>"$LOG" 2>&1

if im_ready; then
    log "依赖已就绪，清除 install-warning.json"
    [ -n "$WARN" ] && rm -f "$WARN" 2>/dev/null
    exit 0
fi

log "依赖仍未就绪，写安装告警：${WARN:-（未指定路径）}"
write_warning "离线依赖未安装完成：worker 已退出，但 fcitx5-rime / rime-inputmethod 仍未就绪"
exit 1
WRAPPER_EOF
    chmod 0755 "$WRAPPER" 2>/dev/null
    chown root:root "$WRAPPER" 2>/dev/null || true
    [ -x "$WRAPPER" ]
}

mkdir -p "$LOGDIR" 2>/dev/null && chmod 755 "$LOGDIR" 2>/dev/null

if rime_im_installed; then
    say "已检测到 fcitx5-rime，跳过输入法依赖安装。"
    rm -f "$WARN_FILE" 2>/dev/null
else
    if install_worker_wrapper; then
        say "未检测到 fcitx5-rime：已排入后台安装队列（有网走 apt，无网用自带 .deb）。"
        if command -v setsid >/dev/null 2>&1; then
            setsid nohup bash "$WRAPPER" "$WARN_FILE" >>"$LOG" 2>&1 </dev/null &
        else
            nohup bash "$WRAPPER" "$WARN_FILE" >>"$LOG" 2>&1 </dev/null &
        fi
        say "安装日志：$LOG（另开终端 tail -f 可看进度）"
        say "若最终失败，会写 $WARN_FILE，应用「设置 → 诊断包」里会显示红条"
    else
        say "未检测到 fcitx5-rime，且无法生成 $WRAPPER，请手工安装输入法（见下方提示）。"
        write_install_warning "fcitx5-rime" "无法生成 $WRAPPER，依赖安装没有开始"
    fi
fi

# ---------------------------------------------------- schema 增强配置模板
# 随包 3 个保留方案的 <schema>.custom.yaml 由 rime-inputmethod 装到
# /usr/share/rime-sync/defaults/schemas/：给引擎加 rimesync_vnum / rimesync_punct，
# 并把 punctuator 半角主字符改成单值 commit（没装插件时的兜底）。
# 写入规则（与 Windows 安装器一致）：
#   * 用户 Rime 目录里已有同名文件 -> 沿用，绝不覆盖、不改名、不备份；
#   * 缺失的才补；升级安装同样如此（卸载旧版不动用户目录，所以升级后仍是沿用）；
#   * /usr/share/rime-data 里没有该方案数据时跳过（写了也没有对应 schema）。
#   * 每个模板的结果都记日志：seed file=<name> result=new|reuse|skip
SCHEMA_TEMPLATE_DIR=/usr/share/rime-sync/defaults/schemas
SCHEMA_SEED_LOG=$LOGDIR/schema-tweaks.log

seed_result() { # $1=文件名 $2=new|reuse|skip
    say "seed file=$1 result=$2"
    printf '%s seed file=%s result=%s\n' "$(date '+%F %T')" "$1" "$2" \
        >>"$SCHEMA_SEED_LOG" 2>/dev/null || true
}

seed_schema_customs() { # $1=Rime 用户目录
    local rime_dir=$1 tpl base owner wrote=0 kept=0 no_data=0
    owner=${TARGET_USER:-root}
    [ -d "$SCHEMA_TEMPLATE_DIR" ] || return 0
    if ! mkdir -p "$rime_dir" 2>/dev/null; then
        say "无法创建 $rime_dir，跳过 schema 增强配置"
        return 0
    fi
    for tpl in "$SCHEMA_TEMPLATE_DIR"/*.custom.yaml; do
        [ -f "$tpl" ] || continue
        base=${tpl##*/}
        if [ ! -f "/usr/share/rime-data/${base%.custom.yaml}.schema.yaml" ]; then
            no_data=$((no_data + 1))
            seed_result "$base" skip
            continue
        fi
        if [ -f "$rime_dir/$base" ]; then
            kept=$((kept + 1))
            seed_result "$base" reuse
            continue
        fi
        if install -m 600 "$tpl" "$rime_dir/$base" 2>/dev/null; then
            chown "$owner" "$rime_dir/$base" 2>/dev/null || true
            wrote=$((wrote + 1))
            seed_result "$base" new
        fi
    done
    say "schema 增强配置：写入 $wrote 个，已存在沿用 $kept 个，缺方案数据跳过 $no_data 个"
    printf '%s wrote=%d kept=%d no_data=%d dir=%s\n' \
        "$(date '+%F %T')" "$wrote" "$kept" "$no_data" "$rime_dir" >>"$SCHEMA_SEED_LOG" 2>/dev/null || true
}

# ---------------------------------------------------- 用户 custom.yaml 增量修补
# 更新到新版本后，老设备「沿用」的旧 custom.yaml 可能缺后来才加的增强组件
# （比如此键盘 / 中文标点直出 / v 转数字）。这里补齐：只补缺的那几项，
# 用户改过的内容原样保留（非 rime-sync 管理的文件一律跳过）。
repair_user_customs() { # $1=Rime 用户目录
    local rime_dir=$1 owner=${TARGET_USER:-root} group
    group=$(id -gn "$owner" 2>/dev/null || echo "$owner")
    [ -x "$CLI_HELPER" ] || return 0
    [ -d "$rime_dir" ] || return 0
    "$CLI_HELPER" repair-customs --rime-dir "$rime_dir" >/dev/null 2>&1 || true
    # CLI 以 root 身份跑，写出来的文件属主会变成 root —— 补回给用户。
    for f in "$rime_dir"/*.custom.yaml "$rime_dir"/*.custom.yaml.rimesync-orig; do
        [ -f "$f" ] || continue
        chown "$owner:$group" "$f" 2>/dev/null || true
    done
    say "用户方案配置：已增量补齐缺失的增强组件（你改过的内容原样保留）"
}

# ---------------------------------------------------- 用户方案列表补齐
# 用户的 default.custom.yaml 里的 schema_list 就是「装了哪些方案」的清单。
# librime 只按 schema_list 生成 build/ —— 清单里没有的方案，一次全量重新部署
# 就会连编译产物一起被清掉，用户正在用的方案会「凭空消失」。
#
# 保留清单（packaging/rime/retained-schemas.txt）里的方案必须出现在这个清单里。
# 补齐逻辑本来在 rime_state::ensure 里（Windows 首启走它，所以 Windows 有这个
# 补齐），但 Linux 这边只调了 repair-customs（不管 schema_list）与
# prune-schemas（只删不补），走不到 ensure ⇒ Linux 装/升级后保留方案永远补不进来。
# 这里补上这一段：只在列表末尾追加缺失的保留方案，用户已有的条目与顺序一律不动，
# 改前把原文件备份成 default.custom.yaml.rimesync-orig。
repair_schema_list() { # $1=Rime 用户目录
    local rime_dir=$1 owner=${TARGET_USER:-root} group
    group=$(id -gn "$owner" 2>/dev/null || echo "$owner")
    [ -x "$CLI_HELPER" ] || return 0
    [ -d "$rime_dir" ] || return 0
    "$CLI_HELPER" repair-schema-list --user-dir "$rime_dir" >/dev/null 2>&1 || true
    # CLI 以 root 身份跑，写出来的文件属主会变成 root —— 补回给用户。
    for f in "$rime_dir"/default.custom.yaml "$rime_dir"/default.custom.yaml.rimesync-orig; do
        [ -f "$f" ] || continue
        chown "$owner:$group" "$f" 2>/dev/null || true
    done
    say "方案列表：已补齐随包保留的输入方案（你原有的方案与顺序不变）"
}
# ---------------------------------------------------- 预编译 build 产物兜底
# 有些机器上 rime 部署永远不产出 build/（Windows 上实测 WeaselDeployer /deploy 返回 0
# 但什么都不写；Linux 上也会被用户目录权限 / 插件版本搞坏）。随 IME 包带的
# /usr/share/rime-sync/prebuilt 是别处已经部署好的产物：用户目录缺 build 时铺过去。
# 判据与 Windows 安装器一致：build/luna_pinyin_simp.schema.yaml 存在，且里面有
# rimesync_vnum / rimesync_punct 插件标记（官方部署出来的没有）。
# 开关：RIMESYNC_PREBUILT=0 关闭；RIMESYNC_PREBUILT=force 覆盖已存在的文件。
PREBUILT_DIR=${RIMESYNC_PREBUILT_DIR:-/usr/share/rime-sync/prebuilt}
PREBUILT_LOG=$LOGDIR/prebuilt.log
# 随包产物的清单（每个文件的 sha256 + size）。口径与 Rust 侧
# crates/core/src/prebuilt.rs 的 verify_manifest 一致：**只校验 files[] 里的条目**，
# generated_at / docker_image 这类元数据不一致不报错。
PREBUILT_MANIFEST=${RIMESYNC_PREBUILT_MANIFEST:-$PREBUILT_DIR/MANIFEST.json}
# 清单解析结果缓存（TSV：path<TAB>bytes<TAB>sha256），由 prebuilt_manifest_load 生成。
PREBUILT_MANIFEST_CACHE=""

prebuilt_usable() { # $1=Rime 用户目录
    local f=$1/build/luna_pinyin_simp.schema.yaml
    [ -f "$f" ] || return 1
    grep -q rimesync_vnum "$f" 2>/dev/null || return 1
    grep -q rimesync_punct "$f" 2>/dev/null || return 1
}

# 解析 MANIFEST.json 的 files[] → TSV 缓存。
# 返回：0 = 清单可用；1 = 清单不存在（旧版 payload，Rust 侧同样不校验）；
#       2 = 清单存在但解析不出条目（当损坏处理，见 prebuilt_copy_dir）。
#
# 解析方式：MANIFEST.json 由 scripts/ime/gen-prebuilt-build.py 生成，条目形如
#   { "path": "build/x.bin", "bytes": 123, "sha256": "…" }
# 这里按 JSON 对象的 "}" 边界聚合，与键的先后顺序无关。
prebuilt_manifest_load() {
    local manifest=$1 out=$2 path="" bytes="" sha="" line in_files=0
    PREBUILT_MANIFEST_CACHE=""
    [ -f "$manifest" ] || return 1
    [ -r "$manifest" ] || return 2
    : >"$out" 2>/dev/null || return 2
    while IFS= read -r line || [ -n "$line" ]; do
        # 只解析 "files" 数组段（顶层的 schemas / markers 等段落里也可能出现
        # 大括号，不能让它们干扰条目边界）。
        if [ "$in_files" = 0 ]; then
            case "$line" in
                *'"files"'*) in_files=1 ;;
            esac
            continue
        fi
        case "$line" in
            ']'*) break ;;
        esac
        case "$line" in
            *'"path"'*)
                path=$(printf '%s' "$line" | sed -n 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
                ;;
        esac
        case "$line" in
            *'"bytes"'*)
                bytes=$(printf '%s' "$line" | sed -n 's/.*"bytes"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
                ;;
        esac
        case "$line" in
            *'"sha256"'*)
                sha=$(printf '%s' "$line" | sed -n 's/.*"sha256"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
                ;;
        esac
        # 一个 JSON 对象结束（"}" 独占一行或行尾带 ","）：三个字段齐了才落一条。
        case "$line" in
            *'}'*)
                if [ -n "$path" ] && [ -n "$sha" ]; then
                    printf '%s\t%s\t%s\n' "$path" "${bytes:-0}" "$sha" >>"$out"
                fi
                path=""; bytes=""; sha=""
                ;;
        esac
    done <"$manifest"
    [ -s "$out" ] || return 2
    return 0
}

# 校验单个源文件；返回 0 = 通过，1 = 不匹配/读不出，2 = 清单里没有这个文件。
# 比对两个字段：size（清单 bytes > 0 时）与 sha256（大小写不敏感，同 Rust 侧）。
prebuilt_verify_file() { # $1=清单相对路径 $2=源文件 $3=清单缓存
    local rel=$1 src=$2 cache=$3 entry="" want_bytes="" want_sha="" got_bytes="" got_sha=""
    entry=$(awk -F'\t' -v k="$rel" '$1 == k { print $2 "\t" $3; exit }' "$cache" 2>/dev/null)
    [ -n "$entry" ] || return 2
    want_bytes=${entry%%	*}
    want_sha=${entry#*	}
    got_bytes=$(stat -c%s "$src" 2>/dev/null) || return 1
    got_sha=$(sha256sum "$src" 2>/dev/null | cut -d' ' -f1) || return 1
    [ -n "$got_sha" ] || return 1
    if [ "${want_bytes:-0}" -gt 0 ] 2>/dev/null && [ "$want_bytes" != "$got_bytes" ]; then
        # 格式与 Rust 侧 verify_manifest 的 "<path>:size:expected=.. actual=.." 对齐
        printf '%s:size:expected=%s actual=%s' "$rel" "$want_bytes" "$got_bytes" >&2
        return 1
    fi
    # sha256 大小写不敏感（与 Rust 侧的 eq_ignore_ascii_case 一致）。
    want_sha=$(printf '%s' "$want_sha" | tr 'A-Z' 'a-z')
    got_sha=$(printf '%s' "$got_sha" | tr 'A-Z' 'a-z')
    if [ "$want_sha" != "$got_sha" ]; then
        # 格式与 Rust 侧 verify_manifest 的 "<path>:sha256:expected=.. actual=.." 对齐
        printf '%s:sha256:expected=%s actual=%s' "$rel" "$want_sha" "$got_sha" >&2
        return 1
    fi
    return 0
}

# 列出清单里有、但 payload 目录里没有的条目（与 Rust 侧 "<path>:missing:" 对齐）。
prebuilt_manifest_missing() { # $1=清单缓存 $2=payload 根目录
    local cache=$1 root=$2 rel
    awk -F'\t' '{ print $1 }' "$cache" 2>/dev/null | while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        [ -f "$root/$rel" ] || printf '%s:missing:not-found\n' "$rel"
    done
}

# 逐个文件复制：存在即跳过；mode=force 才覆盖。
# **复制前按 MANIFEST 校验 sha256（与 size）**：不匹配 / 清单里没有的文件一律不拷。
# 输出 "copied kept failed corrupt"（corrupt = 校验没通过、没装上的文件数）。
prebuilt_copy_dir() { # $1=源目录 $2=目标目录 $3=mode $4=属主:属组 $5=清单缓存 $6=清单里的目录名
    local src=$1 dst=$2 mode=$3 owner=$4 cache=$5 prefix=$6
    local f rel rc copied=0 kept=0 failed=0 corrupt=0 reason=""
    if ! mkdir -p "$dst" 2>/dev/null; then printf '0 0 1 0\n'; return 0; fi
    for f in "$src"/*; do
        [ -f "$f" ] || continue
        rel="$prefix/${f##*/}"
        # 既有策略：用户目录里已有同名文件就沿用、不覆盖（2026-11-02 定案）。
        # 沿用的文件根本不复制，所以不必校验它。
        if [ -e "$dst/${f##*/}" ] && [ "$mode" != force ]; then
            kept=$((kept + 1)); continue
        fi
        # 要复制了 ⇒ 先按 MANIFEST 校验 sha256（与 size）。校验不过就不拷。
        if [ -n "$cache" ] && [ -f "$cache" ]; then
            reason=$(prebuilt_verify_file "$rel" "$f" "$cache" 2>&1)
            rc=$?
            if [ "$rc" -ne 0 ]; then
                # rc=2：清单里没有这个文件（无法校验）—— 同样不拷。
                [ "$rc" = 2 ] && reason="not-in-manifest"
                corrupt=$((corrupt + 1))
                # 注意：say 走 stdout，而本函数的 stdout 会被 read 捕获成计数，
                # 所以这里的告警必须写到 stderr，否则会污染计数解析。
                say "!! 预编译产物校验不通过，未复制：$rel（${reason:-unknown}）" >&2
                printf '%s corrupt file=%s reason=%s\n' "$(date '+%F %T')" "$rel" "${reason:-unknown}" \
                    >>"$PREBUILT_LOG" 2>/dev/null || true
                continue
            fi
        fi
        if install -D -m 644 "$f" "$dst/${f##*/}" 2>/dev/null; then
            chown "$owner" "$dst/${f##*/}" 2>/dev/null || true
            copied=$((copied + 1))
        else
            failed=$((failed + 1))
        fi
    done
    printf '%s %s %s %s\n' "$copied" "$kept" "$failed" "$corrupt"
}

seed_prebuilt_build() { # $1=Rime 用户目录
    local rime_dir=$1 mode=${RIMESYNC_PREBUILT:-auto} owner=${TARGET_USER:-root}
    local ogroup copied=0 kept=0 failed=0 c k f b corrupt=0 escalated=0 rel
    local manifest_cache="" manifest_rc=0
    ogroup=$(id -gn "$owner" 2>/dev/null || echo "$owner")

    case "$mode" in
        0|no|off|false)
            say "预编译产物：已按 RIMESYNC_PREBUILT=0 关闭"
            printf '%s skip reason=disabled-by-env\n' "$(date '+%F %T')" >>"$PREBUILT_LOG" 2>/dev/null || true
            return 0 ;;
    esac
    if [ ! -d "$PREBUILT_DIR/build" ]; then
        say "预编译产物：包里没有 $PREBUILT_DIR/build，跳过"
        printf '%s skip reason=payload-missing\n' "$(date '+%F %T')" >>"$PREBUILT_LOG" 2>/dev/null || true
        return 0
    fi
    if [ "$mode" != "force" ] && prebuilt_usable "$rime_dir"; then
        say "预编译产物：$rime_dir/build 已可用，沿用（未覆盖）"
        printf '%s skip reason=build-usable dir=%s\n' "$(date '+%F %T')" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
        return 0
    fi
    if ! mkdir -p "$rime_dir/build" 2>/dev/null; then
        say "!! 无法创建 $rime_dir/build，跳过预编译产物"
        printf '%s failed reason=no-dir dir=%s\n' "$(date '+%F %T')" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
        return 0
    fi
    chown "$owner:$ogroup" "$rime_dir/build" 2>/dev/null || true

    # 解析清单（复制前校验用）。清单缺失 = 旧版 payload（没有清单就没法校验），
    # 与 Rust 侧 verify_manifest 的口径一致：**不校验，也不算失败**。
    # 清单存在但解析不出条目 = 清单本身坏了：此时**不复制任何文件**（宁可不装，
    # 也不能装一份无法验证的产物），并把失败记进日志 + 写 install-warning.json。
    manifest_cache=$(mktemp "${TMPDIR:-/tmp}/rime-sync-manifest.XXXXXX" 2>/dev/null || printf '')
    if [ -n "$manifest_cache" ]; then
        prebuilt_manifest_load "$PREBUILT_MANIFEST" "$manifest_cache"
        manifest_rc=$?
    else
        manifest_rc=2
    fi
    case "$manifest_rc" in
        0)
            say "预编译产物：已按 MANIFEST 校验 sha256 后复制"
            printf '%s manifest=ok path=%s\n' "$(date '+%F %T')" "$PREBUILT_MANIFEST" \
                >>"$PREBUILT_LOG" 2>/dev/null || true
            ;;
        1)
            say "预编译产物：没有 $PREBUILT_MANIFEST（旧版产物，无清单可校验），按原样复制"
            printf '%s manifest=missing path=%s\n' "$(date '+%F %T')" "$PREBUILT_MANIFEST" \
                >>"$PREBUILT_LOG" 2>/dev/null || true
            [ -n "$manifest_cache" ] && rm -f "$manifest_cache" 2>/dev/null
            manifest_cache=""
            ;;
        *)
            say "!! 预编译产物的 MANIFEST 解析失败（$PREBUILT_MANIFEST），本次不复制任何产物"
            printf '%s manifest=broken path=%s\n' "$(date '+%F %T')" "$PREBUILT_MANIFEST" \
                >>"$PREBUILT_LOG" 2>/dev/null || true
            write_install_warning "rime-inputmethod" \
                "随包预编译产物校验失败：$PREBUILT_MANIFEST 解析不出来，已跳过全部预编译产物（输入法可能缺方案）"
            [ -n "$manifest_cache" ] && rm -f "$manifest_cache" 2>/dev/null
            return 0
            ;;
    esac

    # 第一遍：build/* -> <rime_dir>/build/，config/*.yaml -> <rime_dir>/（都是存在即跳过）
    read -r c k f b <<<"$(prebuilt_copy_dir "$PREBUILT_DIR/build" "$rime_dir/build" "${mode}" "$owner:$ogroup" "$manifest_cache" build)"
    copied=$((copied + c)); kept=$((kept + k)); failed=$((failed + f)); corrupt=$((corrupt + b))
    read -r c k f b <<<"$(prebuilt_copy_dir "$PREBUILT_DIR/config" "$rime_dir" "${mode}" "$owner:$ogroup" "$manifest_cache" config)"
    copied=$((copied + c)); kept=$((kept + k)); failed=$((failed + f)); corrupt=$((corrupt + b))

    # 第二遍（只在第一遍没解决问题时）：用户目录里本来就有旧的 build 产物（没有插件标记，
    # 例如上次部署留下的），「存在即跳过」把它们跳过去了。build/ 是部署器随时重写的派生
    # 数据、不是用户数据，所以只对 build/ 强制覆盖重铺一遍；config/*.yaml 是用户配置，
    # 绝不参与这一遍。
    if ! prebuilt_usable "$rime_dir" && [ "$mode" != "force" ]; then
        escalated=1
        say "预编译产物：用户目录里的旧 build 产物不可用，只对 build/ 覆盖重铺一遍（配置不动）"
        read -r c k f b <<<"$(prebuilt_copy_dir "$PREBUILT_DIR/build" "$rime_dir/build" force "$owner:$ogroup" "$manifest_cache" build)"
        copied=$((copied + c)); kept=$((kept + k)); failed=$((failed + f)); corrupt=$((corrupt + b))
    fi

    # 清单里有、payload 里没有的条目（Rust 侧记作 "<path>:missing:"）也算问题：
    # 装上去的产物是不完整的。
    # 注意：这里不能用管道（管道里的 while 是子 shell，计数传不回来）。
    missing_list=$(prebuilt_manifest_missing "$manifest_cache" "$PREBUILT_DIR" 2>/dev/null)
    if [ -n "$missing_list" ]; then
        while IFS= read -r rel; do
            [ -n "$rel" ] || continue
            corrupt=$((corrupt + 1))
            say "!! 预编译产物缺失，未复制：$rel"
            printf '%s corrupt file=%s reason=missing\n' "$(date '+%F %T')" "$rel" \
                >>"$PREBUILT_LOG" 2>/dev/null || true
        done <<EOF_MISSING
$missing_list
EOF_MISSING
    fi

    [ -n "$manifest_cache" ] && rm -f "$manifest_cache" 2>/dev/null

    if [ "$corrupt" -gt 0 ]; then
        # 有文件没装上：写进日志 + 让应用能看见（install-warning.json），但**不让 dpkg 失败**
        # —— 一个坏文件不该把整包安装搞挂。输入法缺文件时由用户自己重装或等下一次安装。
        say "!! 预编译产物有 $corrupt 个文件校验不通过、没有装上（详见 $PREBUILT_LOG）"
        printf '%s partial source=prebuilt copied=%d kept=%d failed=%d corrupt=%d escalated=%d dir=%s\n' \
            "$(date '+%F %T')" "$copied" "$kept" "$failed" "$corrupt" "$escalated" "$rime_dir" \
            >>"$PREBUILT_LOG" 2>/dev/null || true
        write_install_warning "rime-inputmethod" \
            "随包预编译产物有 $corrupt 个文件 sha256/大小校验不通过、没有安装（详见 $PREBUILT_LOG）"
    fi

    if prebuilt_usable "$rime_dir"; then
        say "预编译产物：已铺入 $copied 个，沿用 $kept 个（build 判定通过）"
        printf '%s ok source=prebuilt copied=%d kept=%d failed=%d corrupt=%d escalated=%d dir=%s\n' \
            "$(date '+%F %T')" "$copied" "$kept" "$failed" "$corrupt" "$escalated" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
    else
        say "!! 预编译产物铺完仍不满足判据（copied=$copied kept=$kept failed=$failed corrupt=$corrupt），只告警不中止"
        printf '%s failed source=prebuilt copied=%d kept=%d failed=%d corrupt=%d escalated=%d dir=%s\n' \
            "$(date '+%F %T')" "$copied" "$kept" "$failed" "$corrupt" "$escalated" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
    fi
    return 0
}

# ---------------------------------------------- 非保留方案清理（0.6.21）
# 随包只保留 packaging/rime/retained-schemas.txt 里的 3 个方案（朙月拼音·简化字 /
# 五笔拼音 / 五笔86）。旧版本安装、发行版数据或历史部署会在 data / 用户目录 / build
# 里留下其余方案，这里在 root 期清掉：
#   * 实现只有一份（rime-sync-cli prune-schemas，与 Windows 自举共用 Rust 代码）；
#   * 删除前同目录改名备份为 <原文件名>.rimesync-removed-<时间戳>，可回滚；
#   * 幂等；开关 RIMESYNC_PRUNE_SCHEMAS=0 关闭。
# 失败只告警，绝不让 postinst 中断安装。
PRUNE_LOG=$LOGDIR/prune-schemas.log
prune_extra_schemas() { # 参数 1 = Rime 用户目录（可为空）
    local rime_dir=${1:-} cli=/usr/bin/rime-sync-cli out removed backups failed disabled
    if [ ! -x "$cli" ]; then
        say "方案清理：缺少 $cli，跳过（只告警）"
        printf '%s skip reason=no-cli\n' "$(date '+%F %T')" >>"$PRUNE_LOG" 2>/dev/null || true
        return 0
    fi
    local args=(prune-schemas)
    [ -d /usr/share/rime-data ] && args+=(--data-dir /usr/share/rime-data)
    if [ -n "$rime_dir" ] && [ -d "$rime_dir" ]; then
        args+=(--user-dir "$rime_dir")
    fi
    out=$("$cli" "${args[@]}" 2>&1 || true)
    printf '%s\n' "$out" | while IFS= read -r line; do
        [ -n "$line" ] && printf '%s prune %s\n' "$(date '+%F %T')" "$line" >>"$PRUNE_LOG" 2>/dev/null
    done
    disabled=$(printf '%s\n' "$out" | sed -n 's/^prune_disabled=//p' | head -1)
    removed=$(printf '%s\n' "$out" | sed -n 's/^prune_removed=//p' | head -1)
    backups=$(printf '%s\n' "$out" | sed -n 's/^prune_backups=//p' | head -1)
    failed=$(printf '%s\n' "$out" | sed -n 's/^prune_failed=//p' | head -1)
    if [ "${disabled:-0}" = "1" ]; then
        say "方案清理：已按 RIMESYNC_PRUNE_SCHEMAS=0 关闭"
    else
        say "方案清理：删除 ${removed:-?} 个文件（备份 ${backups:-?}，失败 ${failed:-?}）；清单 /usr/share/rime-sync/retained-schemas.txt"
        printf '%s done removed=%s backups=%s failed=%s dir=%s\n' \
            "$(date '+%F %T')" "${removed:-0}" "${backups:-0}" "${failed:-0}" "${rime_dir:-}" >>"$PRUNE_LOG" 2>/dev/null || true
    fi
    return 0
}

if [ "${1:-}" = "configure" ] && [ -n "$TARGET_HOME" ]; then
    say "Rime 用户目录：$RIME_USER_DIR"
    [ -n "${2:-}" ] && say "升级安装（原版本 $2）：只补缺失的输入法配置，已有文件一律沿用"
    [ "${RIMESYNC_WITH_SCHEMA_TWEAKS:-0}" = "1" ] && \
        say "（RIMESYNC_WITH_SCHEMA_TWEAKS=1：0.6.12 起始终只补缺失文件，该变量不再改变行为）"
    seed_schema_customs "$RIME_USER_DIR"
    # 0.6.15：部署不产出 build 时用随包的预编译产物兜底（缺文件才铺，失败只告警）
    seed_prebuilt_build "$RIME_USER_DIR"
    # 0.6.21：清掉非保留方案的 data / 用户 custom.yaml / build 产物（幂等、带备份）
    prune_extra_schemas "$RIME_USER_DIR"
    # 0.6.30：补齐老设备 custom.yaml 里缺失的新增强组件（只补缺，绝不覆盖用户改动）
    repair_user_customs "$RIME_USER_DIR"
    # 补齐用户方案列表（schema_list）里的随包保留方案。
    # **顺序在 prune_extra_schemas 之后**：prune 只删不补，先补后裁会把刚补上的
    # 方案又裁掉；先裁后补才是「最终列表 = 保留清单」。
    repair_schema_list "$RIME_USER_DIR"
fi
# 用户目录不可用时只清 data（root 期；Linux 的 /usr/share/rime-data 属 root）
if [ "${1:-}" = "configure" ] && [ -z "$TARGET_HOME" ]; then
    prune_extra_schemas ""
fi

