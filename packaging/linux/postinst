#!/bin/bash
# rime-sync postinst
# 原则：安装失败都不许让 postinst 自己中断安装；不在 root 下弹窗；不碰用户数据目录。
#
# 为什么依赖安装是"后台排队"而不是同步执行：
#   dpkg 在运行 postinst 期间持有 /var/lib/dpkg/lock-frontend 与数据库锁，
#   postinst 里直接调 dpkg -i / apt-get install 会被锁拒掉
#   （实测：dpkg: error: dpkg frontend lock was locked by another process）。
#   所以这里只做检测 + 起一个脱离的后台 worker，由它等锁释放后再装。
#
# 失败可见（docs/FALLBACK-POLICY.md）：
#   worker 的失败以前只有 /var/log/rime-sync/vendor-install.log 里的一行字，用户看不到。
#   现在由 /var/lib/rime-sync/install-vendor-deps-wrapper.sh 在失败时写
#     ~/.config/com.rimesync.app/install-warning.json
#   （含时间、包名、日志路径），应用诊断页据此显示红条并提供「查看日志 / 重试」；
#   成功则删掉该文件。重试 = pkexec bash /var/lib/rime-sync/install-vendor-deps-wrapper.sh
set -u

WORKER=/usr/lib/rime-sync/install-vendor-deps.sh
WRAPPER=/var/lib/rime-sync/install-vendor-deps-wrapper.sh
LOGDIR=/var/log/rime-sync

# 桌面入口用 pkexec 直接执行卸载脚本；dpkg-deb 打包自定义文件时不一定保留执行位
# （tauri 的 deb.files 由打包器复制），这里补一次 0755。
UNINSTALLER=/usr/lib/rime-sync/uninstall.sh
[ -f "$UNINSTALLER" ] && chmod 0755 "$UNINSTALLER" 2>/dev/null
# fcitx5-rime 配置页的「查看同步状态」按钮调用它，同样需要执行位。
STATUS_HELPER=/usr/bin/rime-sync-status
[ -f "$STATUS_HELPER" ] && chmod 0755 "$STATUS_HELPER" 2>/dev/null
# fcitx5 配置页的「立即同步」按钮调用它（CLI 由 release.yml 在打包前编译）。
CLI_HELPER=/usr/bin/rime-sync-cli
[ -f "$CLI_HELPER" ] && chmod 0755 "$CLI_HELPER" 2>/dev/null
LOG=$LOGDIR/vendor-install.log

say() { printf '[rime-sync] %s\n' "$*"; }

rime_im_installed() {
    # The offline bundle ships our own rime-inputmethod (Provides: fcitx5-rime),
    # and dpkg-query does not resolve virtual packages by name, so check the
    # concrete package first. Without this the postinst would queue a worker
    # that tries to apt-install the distribution fcitx5-rime, which conflicts
    # with rime-inputmethod and could remove it right after installation.
    [ "$(dpkg-query -W -f='${Status}' rime-inputmethod 2>/dev/null || true)" = "install ok installed" ] ||
        [ "$(dpkg-query -W -f='${Status}' fcitx5-rime 2>/dev/null || true)" = "install ok installed" ]
}

# ---------------------------------------------------------------- 目标用户
# postinst 以 root 运行，但 install-warning.json 必须落到"用桌面的那个人"的
# ~/.config/com.rimesync.app/ 下，否则应用永远读不到。
pick_target_user() {
    local user="${RIMESYNC_TARGET_USER:-}"
    if [ -n "$user" ]; then printf '%s' "$user"; return; fi
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then printf '%s' "$SUDO_USER"; return; fi
    if [ -n "${PKEXEC_UID:-}" ]; then
        user=$(id -nu "$PKEXEC_UID" 2>/dev/null || true)
        if [ -n "$user" ] && [ "$user" != root ]; then printf '%s' "$user"; return; fi
    fi
    user=$(logname 2>/dev/null || true)
    if [ -n "$user" ] && [ "$user" != root ]; then printf '%s' "$user"; return; fi
    # 只有一个普通用户时兜底（离线安装器 / 首次配置最常见的场景）
    local cand
    for cand in /home/*; do
        [ -d "$cand" ] || continue
        user=$(basename "$cand")
        if id -u "$user" >/dev/null 2>&1; then printf '%s' "$user"; return; fi
    done
    printf ''
}

target_home() {
    local user=$1 home=""
    if [ -n "${RIMESYNC_TARGET_HOME:-}" ] && [ -d "${RIMESYNC_TARGET_HOME}" ]; then
        printf '%s' "$RIMESYNC_TARGET_HOME"
        return
    fi
    if [ -n "$user" ]; then
        home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6)
    fi
    if [ -n "$home" ] && [ -d "$home" ]; then printf '%s' "$home"; return; fi
    printf ''
}

TARGET_USER=$(pick_target_user)
TARGET_HOME=$(target_home "$TARGET_USER")
WARN_DIR=""
WARN_FILE=""
if [ -n "$TARGET_HOME" ]; then
    WARN_DIR=$TARGET_HOME/.config/com.rimesync.app
    WARN_FILE=$WARN_DIR/install-warning.json
fi

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

write_install_warning() { # $1=package $2=reason
    local package=$1 reason=$2
    if [ -z "$WARN_FILE" ]; then
        say "找不到桌面用户的 HOME，无法写 install-warning.json；请转告用户：依赖安装未完成，日志 $LOG"
        return 0
    fi
    mkdir -p "$WARN_DIR" 2>/dev/null || {
        say "无法创建 $WARN_DIR，跳过 install-warning.json"
        return 0
    }
    cat >"$WARN_FILE" <<JSON
{
  "schema": 1,
  "written_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
  "package": "$(json_escape "$package")",
  "reason": "$(json_escape "$reason")",
  "log_path": "$(json_escape "$LOG")",
  "retry_command": "pkexec bash $WRAPPER $WARN_FILE"
}
JSON
    chmod 0644 "$WARN_FILE" 2>/dev/null || true
    if [ -n "$TARGET_USER" ]; then
        chown -R "$TARGET_USER":"$(id -gn "$TARGET_USER" 2>/dev/null || echo "$TARGET_USER")" \
            "$WARN_DIR" 2>/dev/null || true
    fi
    say "已写安装告警：$WARN_FILE（应用诊断页会显示红条）"
}

# ---------------------------------------------------------------- worker 包装
# worker 自己永远 exit 0（它把失败吞成一行日志），所以包装脚本按"目标包是否真的
# 装上"判定成败：失败写告警、成功清告警。retry 也复用它（幂等、可重复执行）。
install_worker_wrapper() {
    mkdir -p "$(dirname "$WRAPPER")" 2>/dev/null || return 1
    cat >"$WRAPPER" <<'WRAPPER_EOF'
#!/bin/bash
# 由 rime-sync 的 postinst 生成（每次安装/升级重写），不要手改。
# 用法：install-vendor-deps-wrapper.sh [install-warning.json 路径]
# 退出码：0 = 依赖已就绪（并清掉告警）；1 = 仍未就绪（已写告警）；2 = 缺 worker。
set -u
WORKER=/usr/lib/rime-sync/install-vendor-deps.sh
LOG=/var/log/rime-sync/vendor-install.log
WARN=${1:-}
STATUS_FMT='${Status}'

log() { printf '%s [rime-sync/wrapper] %s\n' "$(date '+%F %T')" "$*"; }

im_ready() {
    [ "$(dpkg-query -W -f="$STATUS_FMT" rime-inputmethod 2>/dev/null || true)" = "install ok installed" ] ||
        [ "$(dpkg-query -W -f="$STATUS_FMT" fcitx5-rime 2>/dev/null || true)" = "install ok installed" ]
}

write_warning() {
    [ -n "$WARN" ] || return 0
    mkdir -p "$(dirname "$WARN")" 2>/dev/null || return 0
    local reason
    reason=$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    cat >"$WARN" <<JSON
{
  "schema": 1,
  "written_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
  "package": "fcitx5-rime",
  "reason": "$reason",
  "log_path": "$LOG",
  "retry_command": "pkexec bash /var/lib/rime-sync/install-vendor-deps-wrapper.sh $WARN"
}
JSON
    chmod 0644 "$WARN" 2>/dev/null || true
}

mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

if [ ! -r "$WORKER" ]; then
    log "缺少 $WORKER，无法安装依赖"
    write_warning "缺少 /usr/lib/rime-sync/install-vendor-deps.sh，离线依赖没有开始安装"
    exit 2
fi

if im_ready; then
    log "依赖已就绪，跳过"
    [ -n "$WARN" ] && rm -f "$WARN" 2>/dev/null
    exit 0
fi

log "开始安装依赖（worker=$WORKER）"
bash "$WORKER" >>"$LOG" 2>&1

if im_ready; then
    log "依赖已就绪，清除 install-warning.json"
    [ -n "$WARN" ] && rm -f "$WARN" 2>/dev/null
    exit 0
fi

log "依赖仍未就绪，写安装告警：${WARN:-（未指定路径）}"
write_warning "离线依赖未安装完成：worker 已退出，但 fcitx5-rime / rime-inputmethod 仍未就绪"
exit 1
WRAPPER_EOF
    chmod 0755 "$WRAPPER" 2>/dev/null
    chown root:root "$WRAPPER" 2>/dev/null || true
    [ -x "$WRAPPER" ]
}

mkdir -p "$LOGDIR" 2>/dev/null && chmod 755 "$LOGDIR" 2>/dev/null

if rime_im_installed; then
    say "已检测到 fcitx5-rime，跳过输入法依赖安装。"
    rm -f "$WARN_FILE" 2>/dev/null
else
    if install_worker_wrapper; then
        say "未检测到 fcitx5-rime：已排入后台安装队列（有网走 apt，无网用自带 .deb）。"
        if command -v setsid >/dev/null 2>&1; then
            setsid nohup bash "$WRAPPER" "$WARN_FILE" >>"$LOG" 2>&1 </dev/null &
        else
            nohup bash "$WRAPPER" "$WARN_FILE" >>"$LOG" 2>&1 </dev/null &
        fi
        say "安装日志：$LOG（另开终端 tail -f 可看进度）"
        say "若最终失败，会写 $WARN_FILE，应用「设置 → 诊断包」里会显示红条"
    else
        say "未检测到 fcitx5-rime，且无法生成 $WRAPPER，请手工安装输入法（见下方提示）。"
        write_install_warning "fcitx5-rime" "无法生成 $WRAPPER，依赖安装没有开始"
    fi
fi

# ---------------------------------------------------- schema 增强配置模板
# 随包 3 个保留方案的 <schema>.custom.yaml 由 rime-inputmethod 装到
# /usr/share/rime-sync/defaults/schemas/：给引擎加 rimesync_vnum / rimesync_punct，
# 并把 punctuator 半角主字符改成单值 commit（没装插件时的兜底）。
# 写入规则（与 Windows 安装器一致）：
#   * 用户 Rime 目录里已有同名文件 -> 沿用，绝不覆盖、不改名、不备份；
#   * 缺失的才补；升级安装同样如此（卸载旧版不动用户目录，所以升级后仍是沿用）；
#   * /usr/share/rime-data 里没有该方案数据时跳过（写了也没有对应 schema）。
#   * 每个模板的结果都记日志：seed file=<name> result=new|reuse|skip
SCHEMA_TEMPLATE_DIR=/usr/share/rime-sync/defaults/schemas
SCHEMA_SEED_LOG=$LOGDIR/schema-tweaks.log

seed_result() { # $1=文件名 $2=new|reuse|skip
    say "seed file=$1 result=$2"
    printf '%s seed file=%s result=%s\n' "$(date '+%F %T')" "$1" "$2" \
        >>"$SCHEMA_SEED_LOG" 2>/dev/null || true
}

seed_schema_customs() { # $1=Rime 用户目录
    local rime_dir=$1 tpl base owner wrote=0 kept=0 no_data=0
    owner=${TARGET_USER:-root}
    [ -d "$SCHEMA_TEMPLATE_DIR" ] || return 0
    if ! mkdir -p "$rime_dir" 2>/dev/null; then
        say "无法创建 $rime_dir，跳过 schema 增强配置"
        return 0
    fi
    for tpl in "$SCHEMA_TEMPLATE_DIR"/*.custom.yaml; do
        [ -f "$tpl" ] || continue
        base=${tpl##*/}
        if [ ! -f "/usr/share/rime-data/${base%.custom.yaml}.schema.yaml" ]; then
            no_data=$((no_data + 1))
            seed_result "$base" skip
            continue
        fi
        if [ -f "$rime_dir/$base" ]; then
            kept=$((kept + 1))
            seed_result "$base" reuse
            continue
        fi
        if install -m 600 "$tpl" "$rime_dir/$base" 2>/dev/null; then
            chown "$owner" "$rime_dir/$base" 2>/dev/null || true
            wrote=$((wrote + 1))
            seed_result "$base" new
        fi
    done
    say "schema 增强配置：写入 $wrote 个，已存在沿用 $kept 个，缺方案数据跳过 $no_data 个"
    printf '%s wrote=%d kept=%d no_data=%d dir=%s\n' \
        "$(date '+%F %T')" "$wrote" "$kept" "$no_data" "$rime_dir" >>"$SCHEMA_SEED_LOG" 2>/dev/null || true
}

# ---------------------------------------------------- 预编译 build 产物兜底
# 有些机器上 rime 部署永远不产出 build/（Windows 上实测 WeaselDeployer /deploy 返回 0
# 但什么都不写；Linux 上也会被用户目录权限 / 插件版本搞坏）。随 IME 包带的
# /usr/share/rime-sync/prebuilt 是别处已经部署好的产物：用户目录缺 build 时铺过去。
# 判据与 Windows 安装器一致：build/luna_pinyin_simp.schema.yaml 存在，且里面有
# rimesync_vnum / rimesync_punct 插件标记（官方部署出来的没有）。
# 开关：RIMESYNC_PREBUILT=0 关闭；RIMESYNC_PREBUILT=force 覆盖已存在的文件。
PREBUILT_DIR=/usr/share/rime-sync/prebuilt
PREBUILT_LOG=$LOGDIR/prebuilt.log

prebuilt_usable() { # $1=Rime 用户目录
    local f=$1/build/luna_pinyin_simp.schema.yaml
    [ -f "$f" ] || return 1
    grep -q rimesync_vnum "$f" 2>/dev/null || return 1
    grep -q rimesync_punct "$f" 2>/dev/null || return 1
}

# 逐个文件复制：存在即跳过；mode=force 才覆盖。输出 "copied kept failed"
prebuilt_copy_dir() { # $1=源目录 $2=目标目录 $3=mode $4=属主:属组
    local src=$1 dst=$2 mode=$3 owner=$4 f copied=0 kept=0 failed=0
    if ! mkdir -p "$dst" 2>/dev/null; then printf '0 0 1\n'; return 0; fi
    for f in "$src"/*; do
        [ -f "$f" ] || continue
        if [ -e "$dst/${f##*/}" ] && [ "$mode" != force ]; then
            kept=$((kept + 1)); continue
        fi
        if install -D -m 644 "$f" "$dst/${f##*/}" 2>/dev/null; then
            chown "$owner" "$dst/${f##*/}" 2>/dev/null || true
            copied=$((copied + 1))
        else
            failed=$((failed + 1))
        fi
    done
    printf '%s %s %s\n' "$copied" "$kept" "$failed"
}

seed_prebuilt_build() { # $1=Rime 用户目录
    local rime_dir=$1 mode=${RIMESYNC_PREBUILT:-auto} owner=${TARGET_USER:-root}
    local ogroup copied=0 kept=0 failed=0 c k f escalated=0
    ogroup=$(id -gn "$owner" 2>/dev/null || echo "$owner")

    case "$mode" in
        0|no|off|false)
            say "预编译产物：已按 RIMESYNC_PREBUILT=0 关闭"
            printf '%s skip reason=disabled-by-env\n' "$(date '+%F %T')" >>"$PREBUILT_LOG" 2>/dev/null || true
            return 0 ;;
    esac
    if [ ! -d "$PREBUILT_DIR/build" ]; then
        say "预编译产物：包里没有 $PREBUILT_DIR/build，跳过"
        printf '%s skip reason=payload-missing\n' "$(date '+%F %T')" >>"$PREBUILT_LOG" 2>/dev/null || true
        return 0
    fi
    if [ "$mode" != "force" ] && prebuilt_usable "$rime_dir"; then
        say "预编译产物：$rime_dir/build 已可用，沿用（未覆盖）"
        printf '%s skip reason=build-usable dir=%s\n' "$(date '+%F %T')" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
        return 0
    fi
    if ! mkdir -p "$rime_dir/build" 2>/dev/null; then
        say "!! 无法创建 $rime_dir/build，跳过预编译产物"
        printf '%s failed reason=no-dir dir=%s\n' "$(date '+%F %T')" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
        return 0
    fi
    chown "$owner:$ogroup" "$rime_dir/build" 2>/dev/null || true

    # 第一遍：build/* -> <rime_dir>/build/，config/*.yaml -> <rime_dir>/（都是存在即跳过）
    read -r c k f <<<"$(prebuilt_copy_dir "$PREBUILT_DIR/build" "$rime_dir/build" "${mode}" "$owner:$ogroup")"
    copied=$((copied + c)); kept=$((kept + k)); failed=$((failed + f))
    read -r c k f <<<"$(prebuilt_copy_dir "$PREBUILT_DIR/config" "$rime_dir" "${mode}" "$owner:$ogroup")"
    copied=$((copied + c)); kept=$((kept + k)); failed=$((failed + f))

    # 第二遍（只在第一遍没解决问题时）：用户目录里本来就有旧的 build 产物（没有插件标记，
    # 例如上次部署留下的），「存在即跳过」把它们跳过去了。build/ 是部署器随时重写的派生
    # 数据、不是用户数据，所以只对 build/ 强制覆盖重铺一遍；config/*.yaml 是用户配置，
    # 绝不参与这一遍。
    if ! prebuilt_usable "$rime_dir" && [ "$mode" != "force" ]; then
        escalated=1
        say "预编译产物：用户目录里的旧 build 产物不可用，只对 build/ 覆盖重铺一遍（配置不动）"
        read -r c k f <<<"$(prebuilt_copy_dir "$PREBUILT_DIR/build" "$rime_dir/build" force "$owner:$ogroup")"
        copied=$((copied + c)); kept=$((kept + k)); failed=$((failed + f))
    fi

    if prebuilt_usable "$rime_dir"; then
        say "预编译产物：已铺入 $copied 个，沿用 $kept 个（build 判定通过）"
        printf '%s ok source=prebuilt copied=%d kept=%d failed=%d escalated=%d dir=%s\n' \
            "$(date '+%F %T')" "$copied" "$kept" "$failed" "$escalated" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
    else
        say "!! 预编译产物铺完仍不满足判据（copied=$copied kept=$kept failed=$failed），只告警不中止"
        printf '%s failed source=prebuilt copied=%d kept=%d failed=%d escalated=%d dir=%s\n' \
            "$(date '+%F %T')" "$copied" "$kept" "$failed" "$escalated" "$rime_dir" >>"$PREBUILT_LOG" 2>/dev/null || true
    fi
    return 0
}

# ---------------------------------------------- 非保留方案清理（0.6.21）
# 随包只保留 packaging/rime/retained-schemas.txt 里的 3 个方案（朙月拼音·简化字 /
# 五笔拼音 / 五笔86）。旧版本安装、发行版数据或历史部署会在 data / 用户目录 / build
# 里留下其余方案，这里在 root 期清掉：
#   * 实现只有一份（rime-sync-cli prune-schemas，与 Windows 自举共用 Rust 代码）；
#   * 删除前同目录改名备份为 <原文件名>.rimesync-removed-<时间戳>，可回滚；
#   * 幂等；开关 RIMESYNC_PRUNE_SCHEMAS=0 关闭。
# 失败只告警，绝不让 postinst 中断安装。
PRUNE_LOG=$LOGDIR/prune-schemas.log
prune_extra_schemas() { # 参数 1 = Rime 用户目录（可为空）
    local rime_dir=${1:-} cli=/usr/bin/rime-sync-cli out removed backups failed disabled
    if [ ! -x "$cli" ]; then
        say "方案清理：缺少 $cli，跳过（只告警）"
        printf '%s skip reason=no-cli\n' "$(date '+%F %T')" >>"$PRUNE_LOG" 2>/dev/null || true
        return 0
    fi
    local args=(prune-schemas)
    [ -d /usr/share/rime-data ] && args+=(--data-dir /usr/share/rime-data)
    if [ -n "$rime_dir" ] && [ -d "$rime_dir" ]; then
        args+=(--user-dir "$rime_dir")
    fi
    out=$("$cli" "${args[@]}" 2>&1 || true)
    printf '%s\n' "$out" | while IFS= read -r line; do
        [ -n "$line" ] && printf '%s prune %s\n' "$(date '+%F %T')" "$line" >>"$PRUNE_LOG" 2>/dev/null
    done
    disabled=$(printf '%s\n' "$out" | sed -n 's/^prune_disabled=//p' | head -1)
    removed=$(printf '%s\n' "$out" | sed -n 's/^prune_removed=//p' | head -1)
    backups=$(printf '%s\n' "$out" | sed -n 's/^prune_backups=//p' | head -1)
    failed=$(printf '%s\n' "$out" | sed -n 's/^prune_failed=//p' | head -1)
    if [ "${disabled:-0}" = "1" ]; then
        say "方案清理：已按 RIMESYNC_PRUNE_SCHEMAS=0 关闭"
    else
        say "方案清理：删除 ${removed:-?} 个文件（备份 ${backups:-?}，失败 ${failed:-?}）；清单 /usr/share/rime-sync/retained-schemas.txt"
        printf '%s done removed=%s backups=%s failed=%s dir=%s\n' \
            "$(date '+%F %T')" "${removed:-0}" "${backups:-0}" "${failed:-0}" "${rime_dir:-}" >>"$PRUNE_LOG" 2>/dev/null || true
    fi
    return 0
}

if [ "${1:-}" = "configure" ] && [ -n "$TARGET_HOME" ]; then
    RIME_USER_DIR=$TARGET_HOME/.local/share/fcitx5/rime
    [ -n "${2:-}" ] && say "升级安装（原版本 $2）：只补缺失的输入法配置，已有文件一律沿用"
    [ "${RIMESYNC_WITH_SCHEMA_TWEAKS:-0}" = "1" ] && \
        say "（RIMESYNC_WITH_SCHEMA_TWEAKS=1：0.6.12 起始终只补缺失文件，该变量不再改变行为）"
    seed_schema_customs "$RIME_USER_DIR"
    # 0.6.15：部署不产出 build 时用随包的预编译产物兜底（缺文件才铺，失败只告警）
    seed_prebuilt_build "$RIME_USER_DIR"
    # 0.6.21：清掉非保留方案的 data / 用户 custom.yaml / build 产物（幂等、带备份）
    prune_extra_schemas "$RIME_USER_DIR"
fi
# 用户目录不可用时只清 data（root 期；Linux 的 /usr/share/rime-data 属 root）
if [ "${1:-}" = "configure" ] && [ -z "$TARGET_HOME" ]; then
    prune_extra_schemas ""
fi

# 刷新菜单与图标缓存（没有这些工具就算了）
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications >/dev/null 2>&1
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1

cat <<'EOM'

